# Environment variables for the serverless functions (api/ on Vercel,
# netlify/functions/ on Netlify). Set these in the host's dashboard, NEVER in
# the repository. Every feature fails closed: without its variables it reports
# an honest error instead of pretending to work.

# --- Callback / contact form (api/contact.js) -------------------------------
# Choose ONE delivery route.
#
# Route A: email through Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=            # a sender on a domain verified in Resend, e.g. noreply@ndcsa.co.za
CONTACT_TO_EMAIL=marketing@ndcsa.co.za
#
# Route B: forward each enquiry as JSON to a webhook (CRM, Zapier, Make, ...)
# CONTACT_WEBHOOK_URL=

# Optional tuning of the per-instance rate limiter (defaults: 5 requests / 10 minutes)
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MS=600000

# --- Assistant free-text answers (api/chat.js) ------------------------------
# Optional. Without it the assistant answers from the site's own approved text.
# ANTHROPIC_API_KEY=

# --- Financial news ingestion (api/ingest-news.js) ---------------------------
# Optional tuning only.
# NEWS_FEEDS=
# NEWS_MAX_ITEMS=30
# NEWS_MAX_AGE_DAYS=30
